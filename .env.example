# Provider configurabile: "github", "gemini" oppure "groq"
AI_PROVIDER="github"

# Inserisci qui le tue chiavi API (verranno lette dal motore di fallback)
GITHUB_TOKEN="ghp_INSERISCI_IL_TUO_TOKEN_GITHUB_MODELS"
GROQ_API_KEY="gsk_INSERISCI_LA_TUA_CHIAVE_GROQ"

# Puoi inserire più chiavi separate (o usarne una sola), il sistema supporta la rotazione (keys_1, keys_2, ecc)
GEMINI_API_KEY="AQ.INSERISCI_LA_TUA_CHIAVE_GEMINI"

# Configurazione Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1

# Inserisci la stringa di connessione DB in produzione se necessaria
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
